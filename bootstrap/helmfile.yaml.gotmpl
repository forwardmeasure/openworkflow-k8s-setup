helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 900
  atomic: true
  createNamespace: true

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: external-secrets
    url: https://charts.external-secrets.io
  - name: istio
    url: https://istio-release.storage.googleapis.com/charts
  - name: strimzi
    url: https://strimzi.io/charts
  - name: codecentric
    url: https://codecentric.github.io/helm-charts
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts

environments:
  gcp:
    values:
      - environments/base.yaml
      - environments/gcp.generated.yaml
  example:
    values:
      - environments/base.yaml
      - environments/gcp.example.yaml

---
releases:
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: {{ .Values.versions.certManager | quote }}
    values:
      - crds:
          enabled: true
        config:
          gatewayAPI:
            enabled: true
        prometheus:
          enabled: {{ .Values.observability.enabled }}

  - name: istio-base
    namespace: istio-system
    chart: istio/base
    version: {{ .Values.versions.istio | quote }}

  - name: istiod
    namespace: istio-system
    chart: istio/istiod
    version: {{ .Values.versions.istio | quote }}
    needs:
      - istio-system/istio-base
    values:
      - pilot:
          autoscaleMin: 2
          autoscaleMax: 5
          resources:
            requests: {cpu: 200m, memory: 256Mi}

  - name: external-secrets
    namespace: external-secrets
    chart: external-secrets/external-secrets
    version: {{ .Values.versions.externalSecrets | quote }}
    values:
      - installCRDs: true
        serviceAccount:
          create: true
          name: external-secrets
          annotations:
            {{- toYaml .Values.externalSecrets.serviceAccountAnnotations | nindent 12 }}
        serviceMonitor:
          enabled: {{ .Values.observability.enabled }}

  - name: kube-prometheus-stack
    installed: {{ .Values.observability.enabled }}
    namespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: {{ .Values.versions.kubePrometheusStack | quote }}
    values:
      - values/kube-prometheus-stack.yaml

  - name: strimzi-kafka-operator
    namespace: kafka
    chart: strimzi/strimzi-kafka-operator
    version: {{ .Values.versions.strimzi | quote }}
    values:
      - watchNamespaces:
          - kafka
        resources:
          requests: {cpu: 100m, memory: 384Mi}
          limits: {memory: 768Mi}

  - name: openworkflow-platform
    namespace: openworkflow-system
    chart: ./charts/openworkflow-platform
    needs:
      - cert-manager/cert-manager
      - external-secrets/external-secrets
      - istio-system/istiod
      - kafka/strimzi-kafka-operator
    values:
      - {{ toYaml .Values | nindent 8 }}

  - name: keycloak
    namespace: identity
    chart: codecentric/keycloakx
    version: {{ .Values.versions.keycloakx | quote }}
    needs:
      - openworkflow-system/openworkflow-platform
    values:
      - values/keycloak.yaml.gotmpl
